# Appearance
font=Inter 18
background-color=#2200aaee
text-color=#ddeeff
border-color=#ccccffff
border-size=3
border-radius=6
padding=20
# Title one notch LARGER than the body (size="larger" is relative, so the
# title stays a step above the body at any base font: 11 on a low-res panel,
# 18 on the design). Body forced white so only the title carries the accent.
format=<big><b>%s</b></big>\n<span foreground="#fff">%b</span>

# Sizing
width=525
height=350
margin=16

# Position: SHAPE-determined, authored in shapes/<shape>/mako.conf (a wall
# centers on the middle output at the bottom, a single panel is top-right).
# mako-placement (link/bin) resolves it each session into placement.active
# (below); the config phase seeds that from the single shape so mako can start
# before the first run.
include=~/.config/mako/placement.active

# Behavior
default-timeout=5000
ignore-timeout=1
group-by=app-name

# Icons
icon-path=/usr/share/icons/Adwaita
icons=1
max-icon-size=80

# Actions (buttons in notifications)
actions=1

# The filter: what `work` and `none` hide, GENERATED by dnd-comms-toggle from
# hush's config (~/.config/hush/config, else the shipped default). Each mode
# hides everything, then un-hides its exceptions, which works because mako
# applies criteria in file order and the last match of an option wins. No
# section below sets `invisible`, so nothing here undoes the filter.
#
# HERE, AND NOT AT THE END OF THE FILE: mako takes `include=` only in the
# global section, and refuses the WHOLE config for one inside a criteria
# section, so it is the last global line, before the first [criteria].
# install renders it, so mako can start before the first toggle.
include=~/.config/mako/filter.active

# Urgency-specific styling
[urgency=low]
background-color=#333333cc
border-color=#BBBBBBcc

[urgency=high]
text-color=#ffeedd
background-color=#550000ee
border-color=#FF4444cc
default-timeout=0

# Match Chrome notifications that have a "Join" action
# We can't match on the existance of "Join" but we can filter on actionable 
# as well as ensure that there is a summary and it comes from Chrome. Hacky.

# commenting this out for now, it's too greedy and matching all chrome notify
[app-name="Google Chrome" actionable=true]
background-color=#001177cc
border-color=#5599FF

# ... and the same Chrome when it arrives through a RELAY that posts under its
# own app name and moves the app's name into the summary ("Google Chrome:
# ..."). Without this, a relayed calendar reminder (which Chrome sends as
# CRITICAL, since it asks to stay up until acted on) falls through to the red
# [urgency=high] look above. Matched by shape, not by relay name, so it
# holds for any relay that keeps that convention.
[summary~="^Google Chrome: " actionable=true]
background-color=#001177cc
border-color=#5599FF


# mux: the host rides on the TITLE row, quietly.
#
# ONE CHARACTER DIFFERENT FROM THE GLOBAL FORMAT, a space where the default
# has \n, and that is the whole trick. mux's notifier prints the host as the
# FIRST LINE OF THE BODY and the real message after it, so joining summary and
# body on one row puts the host beside the session and lets mux's own newline
# make the break:
#
#   Claude finished: api (on northgate)     <- bold, then dim and normal
#   your turn
#
# IT CANNOT BE DONE IN THE SUMMARY. mako interprets Pango in the format and in
# the BODY, never in %s, so markup there would print its own tags. That is why
# the dim span comes from mux's `toast-pango` hook (which emits body text) and
# only the separator is decided here.
#
# THE BODY STAYS WHITE, exactly as the global format decides, so the accent
# still belongs to the title alone. mux's dim span nests INSIDE this one and
# wins for the host, which is the only part meant to recede.
[app-name="mux"]
format=<big><b>%s</b></big> <span foreground="#fff">%b</span>

# AND AGAIN WHEN GROUPED, or the shape changes the moment a second session
# speaks. `[grouped]` is one of mako's BUILT-IN criteria: it swaps in
# `(%g) <b>%s</b>\n%b` and hides all but the first of a group, so without this
# the second banner would silently go back to a two-row title. Only the format
# is overridden here; the grouping and visibility rules are left alone.
[app-name="mux" grouped]
format=(%g) <big><b>%s</b></big> <span foreground="#fff">%b</span>
