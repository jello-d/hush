[Unit]
Description=comms-indicator: SNI tray icon for the notifications filter
After=default.target

[Service]
# The command is a launcher setup.sh writes to ~/.local/bin (execs the hush venv
# python on the daemon); a --user service inherits no login PATH, so name
# ~/.local/bin explicitly. It also shells the dnd-comms-toggle helper (which
# calls makoctl, a system binary), hence the system dirs too.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/comms-indicator
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
