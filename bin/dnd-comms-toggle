#!/bin/sh
# dnd-comms-toggle - the notifications filter over mako: all / work / none.
#
#   dnd-comms-toggle              print the current state
#   dnd-comms-toggle status       ... the same
#   dnd-comms-toggle toggle       cycle all -> work -> none -> all
#   dnd-comms-toggle set STATE    jump to all, work or none
#   dnd-comms-toggle render       re-generate the filter (after the work set
#                                 changed, say) and reload mako; no state change
#
# ONE MODEL, HIDE BY DEFAULT. `all` hides nothing. `work` hides everything
# except the ALLOWLIST and the WORK SET; `none` hides everything except the
# allowlist. The allowlist is what is never personal comms (battery, agent
# alerts, a critical anything), so it flows in every state.
#
# THE WORK SET HAS TWO SOURCES (`work-from` in the config):
#   apps    a hand-kept list of app names (`work-app=`), the standalone default
#   origin  whatever app names a configured command prints, one per line, the
#           first field of each (`origin-command=`). Where work apps run behind
#           a relay that stamps every notification with its origin, this is
#           the preferred mode: work is decided by where a notification CAME
#           FROM, so no app list has to be kept, and the same app on both sides
#           is classified correctly. hush knows nothing about what answers the
#           command; the integrator names it.
#
# IF THE WORK SET CANNOT BE KNOWN (the command fails or prints nothing), `work`
# HIDES NOTHING and says so, on stderr and in a warning file the tray icon
# draws. Losing a work notification silently is the worse failure for a filter
# whose whole job in that state is to let work through.
#
# mako matches criteria in file order and the LAST match of an option wins
# (mako(5) CRITERIA; measured too), which is what "hide all, then un-hide" uses.
# The generated file is include'd by hush's mako config; this script owns it.
set -eu

_run=${XDG_RUNTIME_DIR:-/tmp}
STATE_FILE=$_run/dnd-comms-state
WARN_FILE=$_run/dnd-comms-warn
_cfg=${XDG_CONFIG_HOME:-$HOME/.config}
_self=$(readlink -f "$0" 2>/dev/null || echo "$0")
_default=${_self%/*/*}/share/hush/config
# The user's (or integrator's) config REPLACES the shipped one; no merge, so
# what is in effect is always one file you can read.
CONF=${HUSH_CONFIG:-$_cfg/hush/config}
[ -r "$CONF" ] || CONF=$_default
FILTER=${MAKO_FILTER:-$_cfg/mako/filter.active}

MODE_WORK=hush-work
MODE_NONE=hush-none
# The pre-filter mode names, cleared on every change so a box mid-upgrade
# never keeps one active behind the new ones.
LEGACY_MODES="dnd-personal dnd-comms"

say() { printf 'dnd-comms-toggle: %s\n' "$*" >&2; }

# --- config: key=value lines, `#` comments, list keys repeat ----------------
_KEYS='^(work-from|work-app|origin-command|allow|allow-critical)$'
_conf_bad() {   # -> the offending lines; non-zero when there are none
  awk -v keys="$_KEYS" '/^[ \t]*(#|$)/ { next }
    { i = index($0, "="); k = substr($0, 1, i - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      if (i == 0 || k !~ keys) { printf "  line %d: %s\n", NR, $0; bad = 1 } }
    END { exit !bad }' "$CONF"
}
_conf() {   # <key> -> each value, one per line (a single-value key: the last)
  awk -v k="$1" '/^[ \t]*(#|$)/ { next }
    { i = index($0, "="); key = substr($0, 1, i - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (key != k) next
      v = substr($0, i + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v }' "$CONF"
}
_one() { _conf "$1" | tail -n 1; }

# A name lands inside a quoted mako criteria value, and mako refuses the WHOLE
# config on one bad line, which silences every notification on the box. So a
# name that could break the quoting is refused here instead.
_names_ok() {   # <names, one per line> -> the first bad one; non-zero if none
  printf '%s\n' "$1" | awk '/["\\]/ || /[[:cntrl:]]/ { print; f = 1; exit }
    END { exit !f }'
}

# --- the work set -------------------------------------------------------------
# _work_set: the work app names on stdout. Non-zero, with the reason on stderr,
# when the set cannot be known; `work` then hides nothing.
_work_set() {
  case $(_one work-from) in
  apps|'') _conf work-app ;;
  origin)
    _cmd=$(_one origin-command)
    [ -n "$_cmd" ] || { echo "work-from=origin names no origin-command"; \
      return 1; }
    _rc=0
    _out=$(sh -c "$_cmd" 2>/dev/null) || _rc=$?
    _names=$(printf '%s\n' "$_out" | awk 'NF { print $1 }')
    if [ "$_rc" -ne 0 ]; then
      echo "'$_cmd' exited $_rc, so its list may be incomplete"; return 1
    fi
    [ -n "$_names" ] || { echo "'$_cmd' named no work origin"; return 1; }
    printf '%s\n' "$_names" ;;
  *) echo "work-from must be apps or origin, not '$(_one work-from)'"
    return 1 ;;
  esac
}

# --- the generated filter -----------------------------------------------------
_section() {   # <mode> <criteria> <invisible>
  printf '[mode=%s%s]\ninvisible=%s\n' "$1" "${2:+ $2}" "$3"
}
# _show: un-hide, WITHOUT undoing mako's grouping. mako hides every member of
# a group but the first with its own built-in `[grouped] invisible=1`, and a
# bare `invisible=0` after it shows them all again (measured: two banners of
# one group, where mako draws one). So an ungrouped notification and the first
# of a group are un-hidden, and the rest of a group stays as mako left it.
_show() {   # <mode> <criteria>
  _section "$1" "$2 !grouped" 0
  _section "$1" "$2 group-index=0" 0
}
_exceptions() {   # <mode> <allow names> <critical yes|no>
  printf '%s\n' "$2" | while IFS= read -r _n; do
    [ -z "$_n" ] || _show "$1" "app-name=\"$_n\""
  done
  [ "$3" != yes ] || _show "$1" "urgency=critical"
}

# _filter: write the filter to stdout. Every failure is said on stderr, and an
# unknown work set yields a `work` that hides nothing, never one that hides
# work without saying so.
_filter() {   # <work set or empty> <why empty, if unknown>
  _allow=$(_conf allow)
  _crit=$(_one allow-critical)
  echo "# GENERATED by dnd-comms-toggle from $CONF; edits are overwritten."
  echo "# include'd by hush's mako config. See hush(1)."
  echo
  echo "# none: everything hidden but the allowlist"
  _section "$MODE_NONE" "" 1
  _exceptions "$MODE_NONE" "$_allow" "$_crit"
  echo
  if [ -n "$2" ]; then
    echo "# work: THE WORK SET IS UNKNOWN ($2),"
    echo "# so nothing is hidden: losing work silently is the worse failure."
    return 0
  fi
  echo "# work: everything hidden but the allowlist and the work set"
  _section "$MODE_WORK" "" 1
  _exceptions "$MODE_WORK" "$_allow" "$_crit"
  printf '%s\n' "$1" | while IFS= read -r _n; do
    [ -z "$_n" ] || _show "$MODE_WORK" "app-name=\"$_n\""
  done
}

# _config_problem: why the config cannot be used, on stdout; nothing if fine.
_config_problem() {
  if _lines=$(_conf_bad); then
    printf '%s has lines it does not understand:\n%s\n' "$CONF" "$_lines"
    return 0
  fi
  case $(_one allow-critical) in
  yes|no|'') ;;
  *) echo "allow-critical must be yes or no in $CONF"; return 0 ;;
  esac
  if _bad=$(_names_ok "$(_conf allow)
$(_conf work-app)"); then
    echo "refusing app name '$_bad' in $CONF: a quote or backslash breaks"
    echo "the WHOLE mako config"
  fi
}

# _want: the filter render WOULD write, into <file>. Sets _set (the work set)
# and _why (why it is unknown; empty when known). ONE computation for render,
# check and probe, so what is written, what is audited and what is promised
# cannot disagree.
_want() {   # <file>
  _why=
  _set=$(_work_set 2>&1) || { _why=$_set; _set=; }
  if [ -z "$_why" ] && _bad=$(_names_ok "$_set"); then
    _why="refusing work origin '$_bad' (would break mako's whole config)"
    _set=
  fi
  _filter "$_set" "$_why" > "$1"
}

# render: regenerate the filter, reloading mako only when it changed. A config
# that cannot be read keeps the last good filter (or, with none, writes one
# that hides nothing, since mako will not start with its include missing), and
# the warning names the problem either way.
render() {
  _warn=$(_config_problem)
  if [ -n "$_warn" ]; then
    _note "$_warn"
    [ -e "$FILTER" ] || { mkdir -p "$(dirname "$FILTER")"
      echo "# hush: config unreadable, nothing filtered" > "$FILTER"; }
    return 0
  fi
  mkdir -p "$(dirname "$FILTER")"
  _tmp=$(mktemp "$FILTER.XXXXXX")
  _want "$_tmp"
  if cmp -s "$_tmp" "$FILTER" 2>/dev/null; then
    rm -f "$_tmp"
  else
    mv "$_tmp" "$FILTER"
    # Only a RUNNING mako is told; with none there is nothing to reload, and
    # an install on a headless box must not call makoctl at all.
    if pgrep -x mako >/dev/null 2>&1; then
      makoctl reload >/dev/null 2>&1 || :
    fi
  fi
  if [ -n "$_why" ]; then
    _note "the work set is unknown, so 'work' hides nothing: $_why"
  else
    rm -f "$WARN_FILE"
  fi
}

# check: is the filter on disk what render would write NOW? Exit 0 yes, 1 no
# (one line on stdout says why). Writes nothing.
#
# WRITTEN BECAUSE A STALE FILTER WAS LIVE: the filter is rendered only on a
# state change, an install and an explicit render, so a config placed AFTER
# hush's install (an integrator's sweep, racing) left the shipped default's
# filter in force, while an existence check reported it fine. A changed work
# set (an enclave added) is the same staleness, and this sees both.
check() {
  _warn=$(_config_problem)
  [ -z "$_warn" ] || { echo "the config cannot be used: $_warn"; return 1; }
  [ -e "$FILTER" ] || { echo "there is no filter at $FILTER"; return 1; }
  _tmp=$(mktemp)
  _want "$_tmp"
  if cmp -s "$_tmp" "$FILTER"; then
    rm -f "$_tmp"; return 0
  fi
  rm -f "$_tmp"
  echo "$FILTER is stale against $CONF and the current work set"
  return 1
}

_note() {   # <message>: said on stderr AND left for the tray icon to draw
  say "$1"
  printf '%s\n' "$1" > "$WARN_FILE" 2>/dev/null || :
}

# --- probe: what should show in the CURRENT state, sent for real ------------
# One notification per class the filter decides on, each titled with what it
# should do here. Look at the screen: every banner that appears must say
# SHOWN, and a banner saying HIDDEN is a failure. Toggle and run it again for
# the other states. The work origin is sent DIRECTLY under its name, so this
# tests the filter, not the relay that would normally carry it; the relay is
# the work side's to send through (the line printed last says how).
_expect() {   # <shows in all> <in work> <in none> -> SHOWN or HIDDEN
  case $(get_state) in
  all)  _e=$1 ;;
  work) _e=$2 ;;
  *)    _e=$3 ;;
  esac
  [ "$_e" = y ] && echo SHOWN || echo HIDDEN
}
_probe_one() {   # <app> <urgency> <what> <all> <work> <none>
  _x=$(_expect "$4" "$5" "$6")
  notify-send -a "$1" -u "$2" "hush probe: $3 should be $_x" \
    "state $(get_state); app name '$1'"
  printf '  %-7s %s (app %s)\n' "$_x" "$3" "$1"
}
probe() {
  _warn=$(_config_problem)
  [ -z "$_warn" ] || { say "$_warn"; return 1; }
  command -v notify-send >/dev/null 2>&1 \
    || { say "probe needs notify-send"; return 1; }
  _t=$(mktemp); _want "$_t"; rm -f "$_t"
  # an unknown work set means `work` hides nothing, so expect that too
  _w=n; [ -z "$_why" ] || _w=y
  _a=$(_conf allow | head -n 1)
  echo "state $(get_state); sent, and what each must do:"
  _probe_one hush-probe-personal normal "a personal app" y "$_w" n
  [ -z "$_a" ] || _probe_one "$_a" normal "an allowed app" y y y
  [ "$(_one allow-critical)" != yes ] \
    || _probe_one hush-probe-critical critical "a critical personal" y y y
  _o=$(printf '%s\n' "$_set" | head -n 1)
  [ -z "$_o" ] || _probe_one "$_o" normal "work ($_o, sent directly)" y y n
  [ -z "$_why" ] || echo "  (the work set is unknown, so work hides nothing:"\
    "$_why)"
  echo "Any banner saying HIDDEN is a failure; toggle and rerun for the others."
  [ "$(_one work-from)" != origin ] || [ -z "$_o" ] || echo "Through the" \
    "relay too: work run $_o -- notify-send 'hush probe: via the relay'"
}

# --- state -------------------------------------------------------------------
get_state() {
  _s=$(cat "$STATE_FILE" 2>/dev/null || :)
  case $_s in all|work|none) echo "$_s" ;; *) echo all ;; esac
}

set_state() {   # <state>
  case $1 in
  all|work|none) ;;
  *) say "unknown state '$1' (all, work or none)"; return 2 ;;
  esac
  render
  for _m in "$MODE_WORK" "$MODE_NONE" $LEGACY_MODES; do
    makoctl mode -r "$_m" >/dev/null 2>&1 || :
  done
  case $1 in
  work) makoctl mode -a "$MODE_WORK" >/dev/null ;;
  none) makoctl mode -a "$MODE_NONE" >/dev/null ;;
  esac
  echo "$1" > "$STATE_FILE"
}

cycle_state() {
  case $(get_state) in
  all)  set_state work ;;
  work) set_state none ;;
  *)    set_state all ;;
  esac
}

case ${1:-status} in
  toggle) cycle_state ;;
  set)
    [ -n "${2:-}" ] || { say "usage: dnd-comms-toggle set STATE"; exit 2; }
    set_state "$2" ;;
  render) render ;;
  check) check ;;
  probe) probe ;;
  status) get_state ;;
  -h|--help|help)
    echo "usage: dnd-comms-toggle [status|toggle|set STATE|render|check|probe]"
    ;;
  *) say "unknown command '$1'"; exit 2 ;;
esac
