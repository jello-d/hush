#!/usr/bin/env python3
"""comms-indicator - an SNI tray icon for the notifications filter (all / work /
only-work / none), drawn as an owned glyph (a near-black rounded tile, frame
colour = state) so it reads cleanly beside other status icons.

It is a thin PRESENTER: the state machine + mako integration stay in
dnd-comms-toggle.sh (the single source). This daemon reads the state file to
draw, and left-click cycles by shelling that script's `toggle`. Nothing here
duplicates the mako logic.

Deps: dbus-next (pure-Python D-Bus) + Pillow. Drawn per size, ARGB32 in network
byte order per the StatusNotifierItem spec. `comms-indicator render-test DIR`
dumps preview PNGs (dev aid, no D-Bus).
"""
import asyncio
import os
import sys

from PIL import Image, ImageDraw

# Frame colour + the glyph modifier per state, keyed to what mako is doing.
# all  = everything flows; work = personal (Signal) muted, work (Slack) through;
# none = all comms muted. Frame carries the state; a
# modifier (waves / dot / slash) disambiguates at a glance.
STATE = {
    "all":  {"frame": (0x4C, 0xC9, 0x5A)},   # green -- everything flows
    "work": {"frame": (0xF0, 0xB0, 0x28)},   # amber -- work only
    "none": {"frame": (0xE0, 0x44, 0x44)},   # red -- muted
}
ORDER = ("all", "work", "none")            # cycle order (matches the script)
_BASE = (0x14, 0x15, 0x19)                 # near-black screen
_TINT = 0.14                               # state hue bleed into the screen
_MARGIN = 0.0      # tile inset as a fraction of the size; 0 = frame fills tile
# The existing waybar chat artwork, scaled DOWN and centred in the tile per
# state: chat bubbles (all), a briefcase bubble (work), bubbles under a red
# prohibition (none). Each PNG is cropped to its content bounding box first, so
# centring is by the visible art (the source canvases have uneven padding).
_ICON_DIR = os.path.expanduser(
    os.environ.get("COMMS_ICONS", "~/.config/waybar/icons"))
_ICON = {"all": "chat-all.png", "work": "chat-work.png",
         "none": "chat-none.png"}
_ICON_H = 0.60     # icon height as a fraction of the tile (scaled down)
_ICON_CY = 0.50    # icon vertical centre (fraction of the tile)
_icons = {}        # cache of cropped originals
# 'none' reuses the 'all' bubbles with a red slash struck through them.
_RED = (0xE4, 0x46, 0x46, 0xFF)


def _margin(s):
    return max(0, round(s * _MARGIN))


def _screen(state):
    col = STATE.get(state, STATE["none"])["frame"]
    mix = tuple(int(_BASE[i] * (1 - _TINT) + col[i] * _TINT) for i in range(3))
    return mix + (0xFF,)


def _icon(state):
    im = _icons.get(state)
    if im is None:
        try:
            p = os.path.join(_ICON_DIR, _ICON[state])
            im = Image.open(p).convert("RGBA")
            bb = im.getbbox()
            if bb:
                im = im.crop(bb)        # tight content -> honest centring
        except (OSError, KeyError):
            im = False                  # cache the miss; do not retry per draw
        _icons[state] = im
    return im or None


def _slash(d, s):
    # A red slash across the tile, upper-right corner -> lower-left corner,
    # landing in the frame's two corners; a dark under-stroke gives contrast.
    m = _margin(s)
    w = max(2, int(round(s * 0.085)))
    dk = w + max(2, int(round(s * 0.035)))
    p1 = (s - 1 - m, m)          # upper-right corner
    p2 = (m, s - 1 - m)          # lower-left corner
    d.line([p1, p2], fill=(0, 0, 0, 220), width=dk)
    d.line([p1, p2], fill=_RED, width=w)


def _tile(state, size):
    s = size
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    frame = STATE.get(state, STATE["none"])["frame"] + (0xFF,)
    m = _margin(s)
    d.rounded_rectangle([m, m, s - 1 - m, s - 1 - m], max(2, s // 7),
                        fill=_screen(state), outline=frame,
                        width=max(1, s // 11))
    # 'none' shows the 'all' bubbles struck through with a red slash.
    ic = _icon("all" if state == "none" else state)
    if ic is not None:
        ih = max(1, int(round(s * _ICON_H)))
        iw = max(1, int(round(ih * ic.width / ic.height)))
        ic = ic.resize((iw, ih), Image.LANCZOS)
        ox = (s - iw) // 2
        oy = int(round(s * _ICON_CY - ih / 2))
        img.alpha_composite(ic, (ox, oy))
    if state == "none":
        _slash(d, s)
    return img


def _to_argb(img):
    rgba = img.tobytes("raw", "RGBA")
    out = bytearray(len(rgba))
    for i in range(0, len(rgba), 4):
        out[i] = rgba[i + 3]
        out[i + 1] = rgba[i]
        out[i + 2] = rgba[i + 1]
        out[i + 3] = rgba[i + 2]
    return bytes(out)


def icon_pixmap(state, sizes=(22, 32, 48)):
    out = []
    for s in sizes:
        t = _tile(state, s)
        # The tray fits each icon by its non-transparent bounding box. A glyph
        # that does not reach the top edge is boxed a pixel lower than one that
        # does, so the tray would size/place this icon inconsistently as the
        # state changes. Stamp one invisible (alpha=1) pixel at the top-right
        # corner so the box always reaches the top edge -- a stable box
        # regardless of the drawn glyph, aligned with any other top-reaching
        # status icon. Invisible on screen; bottom/left stay at the frame.
        t.putpixel((s - 1, 0), (0, 0, 0, 1))
        out.append([s, s, _to_argb(t)])
    return out


# --- state feed: read the file the toggle script owns; cycle via the script ---
STATE_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "dnd-comms-state")
TOGGLE = os.environ.get("COMMS_TOGGLE", "dnd-comms-toggle")  # resolved on PATH


def read_state():
    try:
        v = open(STATE_FILE).read().strip()
    except OSError:
        v = "all"
    return v if v in STATE else "all"


def _render_test(outdir):
    os.makedirs(outdir, exist_ok=True)
    for st in ORDER:
        sizes = (22, 32, 48, 96)
        cells = [(_tile(st, z), z) for z in sizes]
        gap = 8
        w = sum(z for _, z in cells) + gap * (len(cells) + 1)
        sheet = Image.new("RGBA", (w, 96 + 2 * gap), (30, 30, 34, 255))
        x = gap
        for tile, z in cells:
            sheet.paste(tile, (x, gap + (96 - z) // 2), tile)
            x += z + gap
        p = os.path.join(outdir, f"comms-{st}.png")
        sheet.save(p)
        print(p)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "render-test":
        _render_test(sys.argv[2] if len(sys.argv) > 2 else "/tmp/comms-test")
        return
    asyncio.run(_run())


# --- SNI service -------------------------------------------------------------
def _run():
    from dbus_next import BusType, PropertyAccess
    from dbus_next.aio import MessageBus
    from dbus_next.service import (ServiceInterface, dbus_property, method,
                                   signal)

    WATCHER = "org.kde.StatusNotifierWatcher"
    WATCHER_PATH = "/StatusNotifierWatcher"
    ITEM_PATH = "/StatusNotifierItem"
    TIP = {"all": "Notifications: ALL (click to filter to work)",
           "work": "Notifications: WORK ONLY (click to mute all)",
           "none": "Notifications: MUTED (click to unmute)"}

    class Indicator(ServiceInterface):
        def __init__(self):
            super().__init__("org.kde.StatusNotifierItem")
            self._state = read_state()
            self._pixmap = icon_pixmap(self._state)

        def refresh(self):
            st = read_state()
            if st != self._state:
                self._state = st
                self._pixmap = icon_pixmap(st)
                self.NewIcon()

        @dbus_property(access=PropertyAccess.READ)
        def Category(self) -> "s":
            return "ApplicationStatus"

        @dbus_property(access=PropertyAccess.READ)
        def Id(self) -> "s":
            return "comms-indicator"

        @dbus_property(access=PropertyAccess.READ)
        def Title(self) -> "s":
            return "notifications"

        @dbus_property(access=PropertyAccess.READ)
        def Status(self) -> "s":
            return "Active"

        @dbus_property(access=PropertyAccess.READ)
        def IconName(self) -> "s":
            return ""

        @dbus_property(access=PropertyAccess.READ)
        def IconPixmap(self) -> "a(iiay)":
            return self._pixmap

        @dbus_property(access=PropertyAccess.READ)
        def OverlayIconName(self) -> "s":
            return ""

        @dbus_property(access=PropertyAccess.READ)
        def AttentionIconName(self) -> "s":
            return ""

        @dbus_property(access=PropertyAccess.READ)
        def AttentionIconPixmap(self) -> "a(iiay)":
            return self._pixmap

        @dbus_property(access=PropertyAccess.READ)
        def ToolTip(self) -> "(sa(iiay)ss)":
            return ["", [], "notifications", TIP.get(self._state, "")]

        @dbus_property(access=PropertyAccess.READ)
        def ItemIsMenu(self) -> "b":
            return False

        @method()
        def Activate(self, x: "i", y: "i"):
            asyncio.get_event_loop().create_task(self._cycle())

        @method()
        def SecondaryActivate(self, x: "i", y: "i"):
            asyncio.get_event_loop().create_task(self._cycle())

        @method()
        def Scroll(self, delta: "i", orientation: "s"):
            pass

        async def _cycle(self):
            try:
                p = await asyncio.create_subprocess_exec(
                    TOGGLE, "toggle",
                    stdout=asyncio.subprocess.DEVNULL,
                    stderr=asyncio.subprocess.DEVNULL)
                await p.communicate()
            except OSError as e:
                print(f"comms-indicator: toggle failed: {e}", flush=True)
            self.refresh()

        @signal()
        def NewIcon(self):
            pass

    async def watch(item):
        while True:
            item.refresh()
            await asyncio.sleep(1.0)

    async def go():
        bus = await MessageBus(bus_type=BusType.SESSION).connect()
        item = Indicator()
        bus.export(ITEM_PATH, item)
        name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        await bus.request_name(name)

        async def register():
            try:
                intro = await bus.introspect(WATCHER, WATCHER_PATH)
                obj = bus.get_proxy_object(WATCHER, WATCHER_PATH, intro)
                w = obj.get_interface(WATCHER)
                await w.call_register_status_notifier_item(name)
                print(f"comms-indicator: registered {name}", flush=True)
            except Exception as e:
                print(f"comms-indicator: register failed: {e}", flush=True)

        # (Re)register whenever the tray watcher (waybar) appears, so a
        # `wb restart` or a late-starting bar never leaves us invisible.
        di = await bus.introspect("org.freedesktop.DBus",
                                  "/org/freedesktop/DBus")
        dobj = bus.get_proxy_object("org.freedesktop.DBus",
                                    "/org/freedesktop/DBus", di)
        dbus = dobj.get_interface("org.freedesktop.DBus")

        def on_owner(n, old, new):
            if n == WATCHER and new:
                asyncio.get_event_loop().create_task(register())
        dbus.on_name_owner_changed(on_owner)

        try:
            owner = await dbus.call_get_name_owner(WATCHER)
        except Exception:
            owner = ""
        if owner:
            await register()
        else:
            print("comms-indicator: waiting for the tray watcher", flush=True)
        asyncio.create_task(watch(item))
        await asyncio.get_event_loop().create_future()

    return go()


if __name__ == "__main__":
    main()
