# test/harness_lib - a tiny harness for hush's tests, sourced by each *.t.
# Call `harness_init <name>`: sets HERE (the repo root), a private scratch dir T
# (removed on exit), and fail/pass. POSIX sh; nothing outside T is touched.
#
# THE CLEANUP TRAP CARRIES THE LITERAL PATH, baked in when it is armed, and
# only after the path is checked: a trap that expands "$T" when it FIRES
# deletes whatever T holds by then, and an empty mktemp answer must never
# reach `rm -rf`. A test that adds its own trap must keep both properties;
# HARNESS_RM is the quoted literal to reuse.
harness_init() {   # <name>
  TEST_NAME=$1
  HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
  T=$(mktemp -d) || T=
  case $T in
  /?*/?*) [ -d "$T" ] || T= ;;
  *) T= ;;
  esac
  [ -n "$T" ] || { printf 'FAIL %s: no scratch dir\n' "$1" >&2; exit 1; }
  HARNESS_RM="'$T'"
  # shellcheck disable=SC2064 # expanded NOW, on purpose (see above)
  trap "rm -rf $HARNESS_RM" EXIT INT TERM
}
pass() { printf 'ok   %s%s\n' "$TEST_NAME" "${1:+ ($1)}"; }
fail() { printf 'FAIL %s: %s\n' "$TEST_NAME" "$1" >&2; exit 1; }
